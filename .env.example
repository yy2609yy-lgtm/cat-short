# 猫咪短视频工作台 / Cat Shorts Workbench
# Copy to .env and adjust. Never commit real keys.

# --- App ---
APP_ENV=local
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
POSTGRES_USER=catshort
POSTGRES_PASSWORD=catshort
POSTGRES_DB=catshort
DATABASE_URL=postgresql+psycopg://catshort:catshort@postgres:5432/catshort

# --- Paths (inside containers; override for local-dev) ---
DATA_DIR=/data
DRIVE_INBOX_DIR=/data/inbox

# --- Drive ---
# mock: scan local inbox folder (offline demo)
# live: Google Drive OAuth + folder id (see README)
DRIVE_MODE=mock
GOOGLE_CLIENT_SECRETS_FILE=/data/secrets/google_client_secrets.json
GOOGLE_TOKEN_FILE=/data/secrets/google_token.json
DRIVE_FOLDER_ID=
DRIVE_SYNC_INTERVAL_SECONDS=120

# --- YouTube ---
# mock: write a local draft record, no network
# live: YouTube Data API v3 OAuth (see README)
YOUTUBE_MODE=mock
YOUTUBE_CLIENT_SECRETS_FILE=/data/secrets/youtube_client_secrets.json
YOUTUBE_TOKEN_FILE=/data/secrets/youtube_token.json
YOUTUBE_DEFAULT_TITLE_PREFIX=Cat Short
YOUTUBE_CATEGORY_ID=15

# --- Render ---
RENDER_MAX_SECONDS=59
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
MUSIC_BED_PATH=/app/assets/music/cozy_afternoon.wav
CAPTION_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# --- Worker / scheduler ---
WORKER_POLL_SECONDS=2
SCHEDULER_TICK_SECONDS=30
